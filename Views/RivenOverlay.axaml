<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:framenion"
        xmlns:riven="clr-namespace:framenion.Src.Riven"
        x:Class="framenion.RivenOverlayWindow"
        x:DataType="local:RivenOverlayWindow"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Background="{DynamicResource RewardWindowBackgroundBrush}"
        Width="340">

    <Border Padding="14" BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">

            <!-- Weapon and overall grade -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                <TextBlock Grid.Column="0"
                           Text="{Binding WeaponName}"
                           FontSize="17"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="1"
                        Background="{Binding OverallGradeBrush}"
                        CornerRadius="4"
                        Padding="10,2"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasGrade}">
                    <TextBlock Text="{Binding OverallGrade}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#101010"/>
                </Border>
                <Button Grid.Column="2"
                        Click="OnCloseClick"
                        Content="&#x2715;"
                        FontSize="12"
                        Width="22"
                        Height="22"
                        Padding="0"
                        Margin="8,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Top"
                        Foreground="{DynamicResource SecondaryForegroundBrush}"
                        ToolTip.Tip="Hide the overlay (scan again to bring it back)"/>
            </Grid>

            <!-- Riven type, disposition, rank -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Subtitle}"
                       FontSize="11"
                       Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       IsVisible="{Binding HasGrade}"/>

            <!-- Stats -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Stats}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="riven:GradedRivenStat">
                        <Grid ColumnDefinitions="56,*,Auto" Margin="0,0,0,5">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayValue}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="6,0,6,0"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="2"
                                    Background="{Binding Grade, Converter={x:Static local:RivenOverlayWindow.GradeBrushConverter}}"
                                    CornerRadius="3"
                                    Padding="7,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Grade}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#101010"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="3"
                       Text="{Binding Warning}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Foreground="#E0A030"
                       IsVisible="{Binding HasWarning}"/>
        </Grid>
    </Border>
</Window>
