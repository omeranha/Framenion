<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="framenion.MainWindow"
        xmlns:local="clr-namespace:framenion"
        xmlns:src="clr-namespace:framenion.Src"
        xmlns:riven="clr-namespace:framenion.Src.Riven"
        x:Name="RootWindow"
        Title="Framenion - A Warframe companion app"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">
        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" Padding="10">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                <!-- Menu Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Button Name="ItemsButton" Content="Equipment" Classes="selected" Click="OnItemsClick" Background="{DynamicResource SurfaceBackgroundBrush}" Padding="20,10"/>
                    <Button Name="InventoryButton" Content="Inventory" Click="OnInventoryClick" Padding="20,10" Background="{DynamicResource SurfaceBackgroundBrush}"/>
                    <Button Name="RelicsButton" Content="Relics" Click="OnRelicsClick" Padding="20,10" Background="{DynamicResource SurfaceBackgroundBrush}"/>
                    <Button Name="RivensButton" Content="Rivens" Click="OnRivensClick" Padding="20,10" Background="{DynamicResource SurfaceBackgroundBrush}"/>
                </StackPanel>

                <!-- Player Info Panel -->
                <ProgressBar Grid.Column="2" MinWidth="100" Name="LoadingBar" IsIndeterminate="true" IsVisible="{Binding #RootWindow.IsLoading}" ToolTip.Tip="Initializing..."
             Height="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="Green" Margin="0, 0, 10, 0"/>
                <Image Grid.Column="3" Name="WarframeOpened" HorizontalAlignment="Right" Width="32" Height="32" VerticalAlignment="Center" ToolTip.Tip="Warframe is closed" Source="avares://framenion/assets/uncheck_d.png" Margin="0, 0, 10, 0"/>
                <Border Grid.Column="4" Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="5" Padding="15,5" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button Name="RefreshInfoButton" Content="↻" Click="OnRefreshInfoClickAsync" Classes="iconButton" ToolTip.Tip="Refresh Inventory Info"/>

                            <Image Name="PlayerIcon" Width="32" Height="32" VerticalAlignment="Center"/>
                            <Image Name="MasteryIcon" Width="32" Height="32" VerticalAlignment="Center"/>

                            <TextBlock Name="MasteryText" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Image Source="avares://framenion/assets/credits.png" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Name="CreditsText" Text="" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Image Source="avares://framenion/assets/platinum.png" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Name="PlatinumText" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>

                        <Button Content="⚙" Click="OnOpenSettingsClick" Classes="iconButton" ToolTip.Tip="Settings"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area: Left = tabs, Right = Void Fissures panel -->
        <Grid Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}" ColumnDefinitions="*,300">

            <!-- ─── LEFT: Tab Content ─── -->
            <Grid Grid.Column="0">
                <!-- Items Content -->
                <Border Name="ItemsContent" IsVisible="True" Padding="20">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,40,40,40,200" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Name="FilterAllButton" Click="OnFilterClick"
                                        Tag="All"
                                        Classes="selected"
                                        Padding="8,8"
                                        ToolTip.Tip="All">
                                    <Image Source="avares://framenion/assets/all.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>

                                <Button Name="FilterWarframesButton"
                                        Click="OnFilterClick"
                                        Tag="Warframes"
                                        Padding="8,8"
                                        ToolTip.Tip="Warframe">
                                    <Image Source="avares://framenion/assets/warframes.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>

                                <Button Name="FilterPrimaryButton"
                                        Click="OnFilterClick"
                                        Tag="Primary"
                                        Padding="8,8"
                                        ToolTip.Tip="Primary">
                                    <Image Source="avares://framenion/assets/primary.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>

                                <Button Name="FilterSecondaryButton"
                                        Click="OnFilterClick"
                                        Tag="Secondary"
                                        Padding="8,8"
                                        ToolTip.Tip="Secondary">
                                    <Image Source="avares://framenion/assets/pistols.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>

                                <Button Name="FilterMeleeButton"
                                        Click="OnFilterClick"
                                        Tag="Melee"
                                        Padding="8,8"
                                        ToolTip.Tip="Melee">
                                    <Image Source="avares://framenion/assets/melee.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>

                                <Button Name="FilterArchgunsButton"
                                        Click="OnFilterClick"
                                        Tag="Archguns"
                                        Padding="8,8"
                                        ToolTip.Tip="Archgun">
                                    <Image Source="avares://framenion/assets/archguns.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>

                                <Button Name="FilterArchmeleeButton"
                                        Click="OnFilterClick"
                                        Tag="Archmelee"
                                        Padding="8,8"
                                        ToolTip.Tip="Archmelee">
                                    <Image Source="avares://framenion/assets/archmelees.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>

                                <Button Name="FilterCompanionsButton"
                                        Click="OnFilterClick"
                                        Tag="Companions"
                                        Padding="8,8"
                                        ToolTip.Tip="Companion">
                                    <Image Source="avares://framenion/assets/sentinels.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>

                                <Button Name="FilterVehiclesButton"
                                        Click="OnFilterClick"
                                        Tag="Vehicles"
                                        Padding="8,8"
                                        ToolTip.Tip="Vehicle">
                                    <Image Source="avares://framenion/assets/archwings.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>

                                <Button Name="FilterAmpsButton"
                                        Click="OnFilterClick"
                                        Tag="Amps"
                                        Padding="8,8"
                                        ToolTip.Tip="Amp">
                                    <Image Source="avares://framenion/assets/amps.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <Button Grid.Column="1"
                Content="−"
                Click="OnItemsZoomOutClick"
                Classes="iconButton"
                ToolTip.Tip="Zoom out"
                Padding="10,6"/>

        <Button Grid.Column="2"
                Content="%"
                Click="OnItemsZoomResetClick"
                Classes="iconButton"
                ToolTip.Tip="Reset zoom"
                Padding="10,6"/>

        <Button Grid.Column="3"
                Content="+"
                Click="OnItemsZoomInClick"
                Classes="iconButton"
                ToolTip.Tip="Zoom in"
                Padding="10,6"/>

                            <TextBox Grid.Column="4"
                                     Name="ItemsSearchBox"
                                     PlaceholderText="Search items"
                                     VerticalAlignment="Center"
                                     Padding="8,8"
                                     TextChanged="OnSearchTextChanged"
                                     Background="{DynamicResource PanelBackgroundBrush}"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="4"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1">

                            <ScrollViewer Name="ItemsScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater Name="ItemsList">
                                    <ItemsRepeater.Layout>
                                        <WrapLayout Orientation="Horizontal"/>
                                    </ItemsRepeater.Layout>

                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="src:Item">
                                            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                    CornerRadius="6"
                                                    Margin="8"
                                                    Padding="12"
                                                    Width="{Binding #RootWindow.ItemsTileWidth}"
                                                    MinHeight="{Binding #RootWindow.ItemsTileMinHeight}"
                                                    BorderBrush="{Binding BorderColor}"
                                                    BorderThickness="2">

                                                <Grid RowDefinitions="Auto,Auto,Auto,*">
                                                    <!-- Main Icon -->
                                                    <Border Grid.Row="0"
                                                            Width="{Binding #RootWindow.ItemsIconSize}"
                                                            Height="{Binding #RootWindow.ItemsIconSize}"
                                                            HorizontalAlignment="Center"
                                                            Background="{DynamicResource AppBackgroundBrush}"
                                                            CornerRadius="4"
                                                            Margin="0,0,0,8"
                                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                                            BorderThickness="1">
                                                        <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                                    </Border>

                                                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsPriceVisible}">
														<Image Source="avares://framenion/assets/platinum.png"
                                                               Stretch="Uniform"
                                                               Width="20" Height="20"
                                                               VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Price}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Name + Mastery -->
                                                    <StackPanel Grid.Row="1"
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                        <Image Name="mastery_icon"
                                                               Source="avares://framenion/assets/mastered.png"
                                                               Stretch="Uniform"
                                                               Width="20" Height="20"
                                                               IsVisible="{Binding Mastered}"
                                                               VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Ingredients -->
                                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Ingredients}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"
                                                                           HorizontalAlignment="Center"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="src:RecipeIngredient">
                                                                <Border Width="46" Height="46"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Background="{Binding BackgroundColor}"
                                                                        CornerRadius="4"
                                                                        Margin="4"
                                                                        BorderBrush="{Binding BorderColor}"
                                                                        BorderThickness="1">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border:pointerover">
                                                                            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        </Style>
                                                                    </Border.Styles>

                                                                    <Grid>
                                                                        <Image Source="{Binding Icon}"
                                                                               Stretch="Uniform"
                                                                               Width="40" Height="40"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               ToolTip.Tip="{Binding}"/>

                                                                        <TextBlock Text="{Binding OwnedCount}"
                                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Bottom"
                                                                                   Background="#80000000"
                                                                                   Padding="2,0"
                                                                                   IsVisible="{Binding IsCountVisible}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="0">
                <!-- Inventory Content -->
                <Border Name="InventoryContent" IsVisible="False" Padding="20">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,40,40,40,200" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Name="FilterInvAllButton" Content="All" Click="OnInventoryCategoryClick" Tag="All" Classes="selected" Padding="12,6"/>
                                <Button Name="FilterInvPartsButton" Content="Parts" Click="OnInventoryCategoryClick" Tag="Component" Padding="12,6" ToolTip.Tip="Chassis, neuroptics, systems, barrels, links and the rest"/>
                                <Button Name="FilterInvBlueprintsButton" Content="Blueprints" Click="OnInventoryCategoryClick" Tag="Blueprint" Padding="12,6"/>
                                <Button Name="FilterInvRelicsButton" Content="Relics" Click="OnInventoryCategoryClick" Tag="Relic" Padding="12,6"/>
                                <Button Name="FilterInvModsButton" Content="Mods" Click="OnInventoryCategoryClick" Tag="Mod" Padding="12,6"/>
                                <Button Name="FilterInvArcanesButton" Content="Arcanes" Click="OnInventoryCategoryClick" Tag="Arcane" Padding="12,6"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="−" Click="OnItemsZoomOutClick" Classes="iconButton" ToolTip.Tip="Zoom out" Padding="10,6"/>
                            <Button Grid.Column="3" Content="%" Click="OnItemsZoomResetClick" Classes="iconButton" ToolTip.Tip="Reset zoom" Padding="10,6"/>
                            <Button Grid.Column="4" Content="+" Click="OnItemsZoomInClick" Classes="iconButton" ToolTip.Tip="Zoom in" Padding="10,6"/>

                            <TextBox Grid.Column="5"
                                     Name="InventorySearchBox"
                                     PlaceholderText="Search inventory"
                                     Padding="8,8"
                                     TextChanged="OnSearchInventoryTextChanged"
                                     VerticalAlignment="Center"
                                     Background="{DynamicResource PanelBackgroundBrush}"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="4"/>
                        </Grid>

                        <!-- Narrowing filters. Clicking an active chip clears it, so each group
                             is a tri-state without needing an explicit "any" chip. -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16" ItemSpacing="16" LineSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Prime" Classes="chipLabel"/>
                                <Button Name="InvPrimeNormalButton" Content="Normal" Tag="Normal" Click="OnInventoryPrimeClick" Classes="chip"/>
                                <Button Name="InvPrimePrimeButton" Content="Prime" Tag="Prime" Click="OnInventoryPrimeClick" Classes="chip"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="Whether the equipment this part builds is already mastered. Relics, mods and arcanes build nothing, so they drop out while this is set.">
                                <TextBlock Text="Mastered" Classes="chipLabel"/>
                                <Button Name="InvMasteredYesButton" Content="Yes" Tag="Yes" Click="OnInventoryMasteredClick" Classes="chip"/>
                                <Button Name="InvMasteredNoButton" Content="No" Tag="No" Click="OnInventoryMasteredClick" Classes="chip"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="Keep only stacks you own more than one of">
                                <TextBlock Text="Amount" Classes="chipLabel"/>
                                <Button Name="InvAmountAnyButton" Content="Any" Tag="0" Click="OnInventoryAmountClick" Classes="chip selected"/>
                                <Button Name="InvAmountManyButton" Content="&gt;1" Tag="2" Click="OnInventoryAmountClick" Classes="chip"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Min plat" Classes="chipLabel"/>
                                <TextBox Name="InventoryMinPlatinumBox"
                                         PlaceholderText="Any"
                                         Width="64"
                                         Padding="6,4"
                                         FontSize="12"
                                         TextChanged="OnInventoryMinPlatinumChanged"
                                         VerticalAlignment="Center"
                                         Background="{DynamicResource PanelBackgroundBrush}"
                                         Foreground="{DynamicResource PrimaryForegroundBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         BorderThickness="1"
                                         CornerRadius="4"/>
                                <TextBlock Text="p" Classes="chipLabel"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Sort" Classes="chipLabel"/>
                                <ComboBox Name="InventorySortBox"
                                          ItemsSource="{Binding #RootWindow.InventorySortOptions}"
                                          SelectedIndex="0"
                                          SelectionChanged="OnInventorySortChanged"
                                          MinWidth="170"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Sort inventory"/>
                                <Button Name="InventorySortDirectionButton"
                                        Content="↓"
                                        Click="OnInventorySortDirectionClick"
                                        Classes="iconButton"
                                        ToolTip.Tip="Highest first"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Value strip: what the filtered view is worth, kept out of the
                             toolbar so a long total cannot squeeze the controls. -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource SurfaceBackgroundBrush}"
                                CornerRadius="6"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                Padding="12,7"
                                Margin="0,0,0,10">
                            <TextBlock Name="InventoryCountText"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Border>

                        <Border Grid.Row="3"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1">

                            <ScrollViewer Name="InventoryScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater Name="InventoryList">
                                    <ItemsRepeater.Layout>
                                        <WrapLayout Orientation="Horizontal"/>
                                    </ItemsRepeater.Layout>

                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="src:InventoryItem">
                                            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                    CornerRadius="6"
                                                    Margin="8"
                                                    Padding="12"
                                                    Width="{Binding #RootWindow.ItemsTileWidth}"
                                                    MinHeight="{Binding #RootWindow.InventoryTileMinHeight}"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                                    BorderThickness="2"
                                                    ToolTip.Tip="{Binding DetailsTooltip}">
                                                <Border.Styles>
                                                    <Style Selector="Border:pointerover">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Style>
                                                </Border.Styles>

                                                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                                                    <!-- Icon, with the stack count left and the ducat flip verdict right -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding QuantityText}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Top"/>

                                                        <Border Grid.Column="1"
                                                                Width="{Binding #RootWindow.ItemsIconSize}"
                                                                Height="{Binding #RootWindow.ItemsIconSize}"
                                                                HorizontalAlignment="Center"
                                                                Background="{DynamicResource AppBackgroundBrush}"
                                                                CornerRadius="4"
                                                                Margin="0,0,0,8"
                                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                                BorderThickness="1">
                                                            <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                                        </Border>

                                                        <Border Grid.Column="2"
                                                                Background="{Binding RatioColor}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                VerticalAlignment="Top"
                                                                IsVisible="{Binding HasRatio}"
                                                                ToolTip.Tip="Ducats per platinum">
                                                            <TextBlock Text="{Binding RatioText}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="#101010"/>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"/>

                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding Category}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               FontSize="11"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,2,0,8"/>

                                                    <!-- Unit prices -->
                                                    <StackPanel Grid.Row="3"
                                                                Orientation="Horizontal"
                                                                Spacing="12"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Image Source="avares://framenion/assets/platinum.png"
                                                                   Width="18" Height="18"
                                                                   VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding PlatinumText}"
                                                                       Foreground="{Binding PlatinumColor}"
                                                                       FontWeight="Bold"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip.Tip="{Binding PlatinumTooltip}"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasDucats}">
                                                            <Image Source="avares://framenion/assets/ducats.png"
                                                                   Width="18" Height="18"
                                                                   VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DucatsText}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                       FontWeight="Bold"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- What the whole stack is worth, which is what decides if a tile matters -->
                                                    <TextBlock Grid.Row="4"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               FontSize="11"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"
                                                               IsVisible="{Binding HasPlatinum}">
                                                        <Run Text="Stack"/>
                                                        <Run Text="{Binding TotalPlatinumText}"/>
                                                        <Run Text="plat"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="0">
                <!-- Relics Content -->
                <Border Name="RelicsContent" IsVisible="False" Padding="20">                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,40,40,40,200" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Name="FilterAllRelicsButton" Click="OnFilterRelicClick"
                                        Tag="All"
                                        Classes="selected"
                                        Padding="8,8"
                                        ToolTip.Tip="All">
                                    <Image Source="avares://framenion/assets/all.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>

                                <Button Name="FilterLithButton"
                                        Click="OnFilterRelicClick"
                                        Tag="Lith"
                                        Padding="8,8"
                                        ToolTip.Tip="Lith">
                                    <Image Source="avares://framenion/assets/lith.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                                <Button Name="FilterMesoButton"
                                        Click="OnFilterRelicClick"
                                        Tag="Meso"
                                        Padding="8,8"
                                        ToolTip.Tip="Meso">
                                    <Image Source="avares://framenion/assets/meso.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                                <Button Name="FilterNeoButton"
                                        Click="OnFilterRelicClick"
                                        Tag="Neo"
                                        Padding="8,8"
                                        ToolTip.Tip="Neo">
                                    <Image Source="avares://framenion/assets/neo.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                                <Button Name="FilterAxiButton"
                                        Click="OnFilterRelicClick"
                                        Tag="Axi"
                                        Padding="8,8"
                                        ToolTip.Tip="Axi">
                                    <Image Source="avares://framenion/assets/axi.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                                <Button Name="FilterRequiemButton"
                                        Click="OnFilterRelicClick"
                                        Tag="Requiem"
                                        Padding="8,8"
                                        ToolTip.Tip="Requiem">
                                    <Image Source="avares://framenion/assets/requiem.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                        <ToggleButton Grid.Column="1"
                                      Name="HideUnownedRelicsButton"
                                      Click="OnToggleUnownedRelicsClick"
                                      Padding="8,8"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Hide relics you do not own">
                            <Image Source="avares://framenion/assets/eye.png" Width="24" Height="24" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <ComboBox Grid.Column="2"
                                  Name="RelicSortBox"
                                  ItemsSource="{Binding #RootWindow.RelicSortOptions}"
                                  SelectedIndex="0"
                                  SelectionChanged="OnRelicSortChanged"
                                  MinWidth="150"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Sort relics"/>

                        <Button Grid.Column="3"
                Content="−"
                Click="OnItemsZoomOutClick"
                Classes="iconButton"
                ToolTip.Tip="Zoom out"
                Padding="10,6"/>

        <Button Grid.Column="4"
                Content="%"
                Click="OnItemsZoomResetClick"
                Classes="iconButton"
                ToolTip.Tip="Reset zoom"
                Padding="10,6"/>

        <Button Grid.Column="5"
                Content="+"
                Click="OnItemsZoomInClick"
                Classes="iconButton"
                ToolTip.Tip="Zoom in"
                Padding="10,6"/>

                            <TextBox Grid.Column="6"
                                     Name="RelicsSearchBox"
                                     PlaceholderText="Search relics or rewards"
                                     Padding="8,8"
                                     TextChanged="OnSearchRelicsTextChanged"
                                     VerticalAlignment="Center"
                                     Background="{DynamicResource PanelBackgroundBrush}"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="4"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1">

                            <ScrollViewer Name="RelicsScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater Name="RelicsList">
                                    <ItemsRepeater.Layout>
                                        <WrapLayout Orientation="Horizontal"/>
                                    </ItemsRepeater.Layout>

                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="src:Relic">
                                            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                    CornerRadius="6"
                                                    Margin="8"
                                                    Padding="12"
                                                    Width="{Binding #RootWindow.ItemsTileWidth}"
                                                    MinHeight="{Binding #RootWindow.ItemsTileMinHeight}"
                                                    BorderThickness="2">

                                                <Grid RowDefinitions="Auto,Auto,Auto,*">
                                                    <!-- Main Icon -->
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <TextBlock Grid.Column="0" IsVisible="{Binding IsCountVisible}">
                                                            <Run Text="x"/><Run Text="{Binding OwnedCount}"/>
                                                        </TextBlock>
                                                        <Image Grid.Column="0" IsVisible="{Binding Unowned}"
                                                               Width="24" Height="24"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"
                                                               Source="avares://framenion/assets/eye.png">
                                                        </Image>
                                                        <Border Grid.Row="0" Grid.Column="1"
                                                                Width="{Binding #RootWindow.ItemsIconSize}"
                                                                Height="{Binding #RootWindow.ItemsIconSize}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource AppBackgroundBrush}"
                                                                CornerRadius="4"
                                                                Margin="0,0,0,8"
                                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                                BorderThickness="1">
                                                            <Image Grid.Column="1"
                                                                   Source="{Binding Icon}"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Name -->
                                                    <StackPanel Grid.Row="1"
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Quality}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   FontSize="11"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Rewards}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="src:Reward">
                                                                <Border Width="46" Height="46"
                                                                        Background="{DynamicResource SecondaryBackgroundBrush}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="4"
                                                                        Margin="4"
                                                                        BorderThickness="1">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border:pointerover">
                                                                            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        </Style>
                                                                    </Border.Styles>

                                                                    <Border BorderThickness="1" BorderBrush="{Binding BorderColor}">
                                                                        <Image Source="{Binding Icon}"
                                                                               Stretch="Uniform"
                                                                               Width="40" Height="40"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               ToolTip.Tip="{Binding CountName}"/>
                                                                    </Border>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Border>
                        </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="0">
                <!-- Rivens Content -->
                <Border Name="RivensContent" IsVisible="False" Padding="20">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,40,40,40,200" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Name="FilterAllRivensButton" Click="OnFilterRivenClick" Tag="All" Classes="selected" Padding="8,8" ToolTip.Tip="All">
                                    <Image Source="avares://framenion/assets/all.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                                <Button Name="FilterRifleRivensButton" Click="OnFilterRivenClick" Tag="Rifle" Padding="8,8" ToolTip.Tip="Rifle">
                                    <Image Source="avares://framenion/assets/primary.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                                <Button Name="FilterShotgunRivensButton" Click="OnFilterRivenClick" Tag="Shotgun" Padding="8,8" ToolTip.Tip="Shotgun">
                                    <Image Source="avares://framenion/assets/shotguns.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                                <Button Name="FilterPistolRivensButton" Click="OnFilterRivenClick" Tag="Pistol" Padding="8,8" ToolTip.Tip="Pistol">
                                    <Image Source="avares://framenion/assets/pistols.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                                <Button Name="FilterMeleeRivensButton" Click="OnFilterRivenClick" Tag="Melee" Padding="8,8" ToolTip.Tip="Melee">
                                    <Image Source="avares://framenion/assets/melee.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                                <Button Name="FilterArchgunRivensButton" Click="OnFilterRivenClick" Tag="Archgun" Padding="8,8" ToolTip.Tip="Archgun">
                                    <Image Source="avares://framenion/assets/archguns.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                                <Button Name="FilterModularRivensButton" Click="OnFilterRivenClick" Tag="Modular" Padding="8,8" ToolTip.Tip="Modular (Zaws and Kitguns)">
                                    <Image Source="avares://framenion/assets/modular.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Name="RivenCountText"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                            <ComboBox Grid.Column="2"
                                      Name="RivenSortBox"
                                      ItemsSource="{Binding #RootWindow.RivenSortOptions}"
                                      SelectedIndex="0"
                                      SelectionChanged="OnRivenSortChanged"
                                      MinWidth="150"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Sort rivens"/>

                            <Button Grid.Column="3" Content="−" Click="OnItemsZoomOutClick" Classes="iconButton" ToolTip.Tip="Zoom out" Padding="10,6"/>
                            <Button Grid.Column="4" Content="%" Click="OnItemsZoomResetClick" Classes="iconButton" ToolTip.Tip="Reset zoom" Padding="10,6"/>
                            <Button Grid.Column="5" Content="+" Click="OnItemsZoomInClick" Classes="iconButton" ToolTip.Tip="Zoom in" Padding="10,6"/>

                            <TextBox Grid.Column="6"
                                     Name="RivensSearchBox"
                                     PlaceholderText="Search weapon or stat"
                                     Padding="8,8"
                                     TextChanged="OnSearchRivensTextChanged"
                                     VerticalAlignment="Center"
                                     Background="{DynamicResource PanelBackgroundBrush}"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="4"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="{DynamicResource RivenPanelBackgroundBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource RivenTileBorderBrush}"
                                BorderThickness="1">

                            <ScrollViewer Name="RivensScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater Name="RivensList">
                                    <ItemsRepeater.Layout>
                                        <WrapLayout Orientation="Horizontal"/>
                                    </ItemsRepeater.Layout>

                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="riven:OwnedRiven">
                                            <Border Background="{DynamicResource RivenTileBackgroundBrush}"
                                                    CornerRadius="6"
                                                    Margin="8"
                                                    Padding="12"
                                                    Width="{Binding #RootWindow.ItemsTileWidth}"
                                                    MinHeight="{Binding #RootWindow.ItemsTileMinHeight}"
                                                    BorderBrush="{DynamicResource RivenTileBorderBrush}"
                                                    BorderThickness="2">

                                                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                                                    <!-- Weapon icon and overall grade -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                        <Border Grid.Column="0"
                                                                Width="{Binding #RootWindow.ItemsIconSize}"
                                                                Height="{Binding #RootWindow.ItemsIconSize}"
                                                                HorizontalAlignment="Center"
                                                                Background="{DynamicResource RivenIconBackgroundBrush}"
                                                                CornerRadius="4"
                                                                Margin="0,0,0,8"
                                                                BorderBrush="{DynamicResource RivenTileBorderBrush}"
                                                                BorderThickness="1">
                                                            <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                                        </Border>

                                                        <Border Grid.Column="1"
                                                                Background="{Binding OverallGrade, Converter={x:Static local:RivenOverlayWindow.GradeBrushConverter}}"
                                                                CornerRadius="4"
                                                                Padding="9,2"
                                                                VerticalAlignment="Top"
                                                                IsVisible="{Binding HasGrade}">
                                                            <TextBlock Text="{Binding OverallGrade}"
                                                                       FontSize="16"
                                                                       FontWeight="Bold"
                                                                       Foreground="#101010"/>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding WeaponName}"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"/>

                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding Subtitle}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               FontSize="11"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,2,0,8"/>

                                                    <!-- Stats -->
                                                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Stats}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="riven:GradedRivenStat">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,3">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding DisplayValue}"
                                                                               MinWidth="48"
                                                                               FontWeight="Bold"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Name}"
                                                                               FontSize="11"
                                                                               TextWrapping="Wrap"
                                                                               Margin="4,0,4,0"
                                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                    <Border Grid.Column="2"
                                                                            Background="{Binding Grade, Converter={x:Static local:RivenOverlayWindow.GradeBrushConverter}}"
                                                                            CornerRadius="3"
                                                                            Padding="5,1"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Grade}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#101010"/>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Grid.Row="4"
                                                               Text="{Binding Footer}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─── RIGHT: Void Fissures Panel (always visible) ─── -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBorderBrush}" BorderThickness="1,0,0,0" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Title and Refresh -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
                        <TextBlock Grid.Column="0" Text="Void Fissures" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Name="FilterListButton" Click="OnFilterListClick" Classes="iconButton" Margin="0,0,5,0" ToolTip.Tip="Fissure Alert Settings">
                            <Image Source="avares://framenion/assets/filter.png" VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="2" Name="RefreshFissuresButton" Content="↻" Click="OnRefreshFissuresClick" Classes="iconButton" ToolTip.Tip="Refresh fissures list"/>
                    </Grid>

                    <!-- Filter Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
                        <Button Name="FissureFilterNormalButton" Content="Normal" Click="OnFissureFilterClick" Tag="Normal" Classes="selected" Padding="12,6"/>
                        <Button Name="FissureFilterSteelPathButton" Content="Steel Path" Click="OnFissureFilterClick" Tag="SteelPath" Padding="12,6"/>
                    </StackPanel>

                    <!-- Fissures List -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="FissuresList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="src:VoidFissure">
                                    <Border Background="{Binding RowBackground}"
                                            BorderBrush="{Binding RowBorderBrush}"
                                            BorderThickness="{Binding RowBorderThickness}"
                                            CornerRadius="6"
                                            Margin="0,0,0,6"
                                            Padding="10">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Tier}"
                                                           Classes="TierText"
                                                           Foreground="{Binding Color}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>

                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,3">
                                                    <TextBlock Text="{Binding TimeRemaining}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3">
                                                <Run Text="{Binding MissionType}"/>
                                                <Run Text="{Binding LevelRange}"/>
                                                <Run Text="-"/>
                                                <Run Text="{Binding Faction}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Row="2" Text="{Binding Location}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>