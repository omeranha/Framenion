<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="framenion.App"
             xmlns:local="using:framenion"
             xmlns:src="using:framenion.Src"
             xmlns:riven="using:framenion.Src.Riven"
             x:DataType="local:App"
             RequestedThemeVariant="Dark">
    <Application.DataContext>
        <local:App />
    </Application.DataContext>

    <!-- Tooltip bodies live here rather than inline in the item template: inline ToolTip.Tip
         content is a concrete object built for every realized ingredient, not on hover. -->
    <Application.DataTemplates>
        <DataTemplate DataType="src:RecipeIngredient">
            <StackPanel Orientation="Vertical" Spacing="5">
                <TextBlock Text="{Binding CountName}" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="5" IsVisible="{Binding IsPriceVisible}">
                    <Image Grid.Column="0" Grid.Row="0" Source="avares://framenion/assets/platinum.png" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Price}" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Image Grid.Column="0" Grid.Row="1" Source="avares://framenion/assets/ducats.png" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Ducats}" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Shown when hovering a weapon tile the community "best rolls" sheet has an entry for. -->
        <DataTemplate DataType="riven:RivenRollsTooltip">
            <StackPanel Orientation="Vertical" Spacing="8" MaxWidth="300">
                <TextBlock Text="BEST RIVEN ROLLS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="riven:RivenRollGroup">
                            <StackPanel Orientation="Vertical" Spacing="2" Margin="0,0,0,8">
                                <TextBlock Text="{Binding PositivesText}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" IsVisible="{Binding HasPositives}"/>
                                <TextBlock Text="{Binding NegativesText}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" IsVisible="{Binding HasNegatives}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding NotesText}" TextWrapping="Wrap" FontStyle="Italic" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" IsVisible="{Binding HasNotes}"/>
            </StackPanel>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#000000"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#141414"/>
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="DefaultBorderBrush" Color="#4A4A4A"/>

        <SolidColorBrush x:Key="ControlBorderBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="SeparatorBorderBrush" Color="#262626"/>

        <!-- Buttons are transparent pills with a white outline, never a filled surface. -->
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonForegroundBrush" Color="White"/>
        <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="#E6E6E6"/>

        <!-- The system's only non-monochrome color. User-configurable; this is just the default. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#C3D9F3"/>

        <!-- Riven mod cards are violet in game, so the rivens tab keeps that hue as a deliberate
             semantic exception to the monochrome rule, the same way warning/success colors are. -->
        <SolidColorBrush x:Key="RivenPanelBackgroundBrush" Color="#241A33"/>
        <SolidColorBrush x:Key="RivenTileBackgroundBrush" Color="#1B1327"/>
        <SolidColorBrush x:Key="RivenTileBorderBrush" Color="#6E45A8"/>
        <SolidColorBrush x:Key="RivenIconBackgroundBrush" Color="#120D1C"/>

        <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="White"/>
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#999999"/>
        <Color x:Key="RewardWindowBackgroundColor">#CC000000</Color> <!-- 80% opacity -->
        <SolidColorBrush x:Key="RewardWindowBackgroundBrush" Color="{DynamicResource RewardWindowBackgroundColor}" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Global styles -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,ui-monospace,monospace"/>
            <Setter Property="TextElement.LetterSpacing" Value="0.6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <Style Selector="Button.selected">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.header">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,ui-monospace,monospace"/>
            <Setter Property="TextElement.LetterSpacing" Value="0.6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.header.selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.iconButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.iconButton Image">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="TextBlock.chipLabel">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,ui-monospace,monospace"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>

        <!-- Text inputs lose their full outline for a single bottom hairline, focus thickens it rather than changing color. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>
    </Application.Styles>
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="assets\operator.ico" ToolTipText="Framenion" Command="{Binding Open}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open" Command="{Binding Open}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Exit" Command="{Binding Exit}"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>