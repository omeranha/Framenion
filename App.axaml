<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="framenion.App"
             xmlns:local="using:framenion"
             xmlns:src="using:framenion.Src"
             x:DataType="local:App"
             RequestedThemeVariant="Default">
    <Application.DataContext>
        <local:App />
    </Application.DataContext>

    <!-- Tooltip bodies live here rather than inline in the item template: inline ToolTip.Tip
         content is a concrete object built for every realized ingredient, not on hover. -->
    <Application.DataTemplates>
        <DataTemplate DataType="src:RecipeIngredient">
            <StackPanel Orientation="Vertical" Spacing="5">
                <TextBlock Text="{Binding CountName}" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="5" IsVisible="{Binding IsPriceVisible}">
                    <Image Grid.Column="0" Grid.Row="0" Source="avares://framenion/assets/platinum.png" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Price}" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Image Grid.Column="0" Grid.Row="1" Source="avares://framenion/assets/ducats.png" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Ducats}" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#252525"/>
        <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#252525"/>

        <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="SeparatorBorderBrush" Color="#3A3A3A"/>

        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="ButtonForegroundBrush" Color="White"/>
        <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="#CCCCCC"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#4A9EFF"/>

        <!-- Riven mod cards are violet in game, so the rivens tab follows suit. -->
        <SolidColorBrush x:Key="RivenPanelBackgroundBrush" Color="#2C2C2C"/> <!-- #2A2139 -->
        <SolidColorBrush x:Key="RivenTileBackgroundBrush" Color="#241A33"/>
        <SolidColorBrush x:Key="RivenTileBorderBrush" Color="#6E45A8"/>
        <SolidColorBrush x:Key="RivenIconBackgroundBrush" Color="#1B1327"/>

        <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="White"/>
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#D0D0D0"/>
        <Color x:Key="RewardWindowBackgroundColor">#CC1E1E1E</Color> <!-- 80% opacity -->
        <SolidColorBrush x:Key="RewardWindowBackgroundBrush" Color="{DynamicResource RewardWindowBackgroundColor}" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Global styles -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}"/>
        </Style>

        <Style Selector="Button.selected">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.iconButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.iconButton Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
    </Application.Styles>
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="assets\operator.ico" ToolTipText="Framenion" Command="{Binding Open}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open" Command="{Binding Open}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Exit" Command="{Binding Exit}"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>