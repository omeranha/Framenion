<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
		<OutputType>WinExe</OutputType>
		<Version>1.2.0</Version>
		<Nullable>enable</Nullable>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>assets\operator.ico</ApplicationIcon>
		<LangVersion>preview</LangVersion>

		<PublishSingleFile>true</PublishSingleFile>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<PublishTrimmed>true</PublishTrimmed>
		<!--Every JsonSerializer call goes through the source-generated context, so the reflection-based fallback is not needed.-->
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<!--workaround for runtime identifier not being set when building from Visual Studio-->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<!--Windows.Media.Ocr is only projected by the windows target framework; linux falls back to PaddleOCR.-->
	<PropertyGroup>
		<TargetFramework Condition="'$(RuntimeIdentifier)' == 'linux-x64'">net10.0</TargetFramework>
		<TargetFramework Condition="'$(RuntimeIdentifier)' != 'linux-x64'">net10.0-windows10.0.19041.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<!--The test project lives under this directory, so keep it out of the app's compile items.-->
		<Compile Remove="tests\**" />
		<AvaloniaXaml Remove="tests\**" />
		<None Remove="tests\**" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Framenion.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.0" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
		<!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
		<PackageReference Include="Avalonia.Diagnostics" Version="11.3.13">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Ecng.Lzma" Version="1.0.65" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260330" />
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
		<AvaloniaResource Include="assets\**\*.*" />
		<Content Include="assets\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!--Windows reads text with the built-in Windows.Media.Ocr engine, so PaddleOCR and its
	    ~266 MB of native runtime are linux-only.-->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
	</ItemGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
		<PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260302" />
		<PackageReference Include="Sdcb.PaddleInference" Version="3.0.1" />
		<PackageReference Include="Sdcb.PaddleOCR" Version="3.0.1" />
		<PackageReference Include="Sdcb.PaddleOCR.Models.Online" Version="3.0.1" />
		<PackageReference Include="Sdcb.PaddleInference.runtime.linux-x64.mkl" Version="3.1.0.54" />
	</ItemGroup>

	<!--OpenCvSharp ships FFmpeg for VideoCapture, which nothing here uses. Dropping it saves
	    ~27 MB; the filter is on the name prefix so an OpenCV version bump keeps working.-->
	<Target Name="DropOpenCvVideoBackendFromBuild" AfterTargets="ResolveReferences">
		<ItemGroup>
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
				Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio'))" />
		</ItemGroup>
	</Target>

	<Target Name="DropOpenCvVideoBackendFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
				Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio'))" />
		</ItemGroup>
	</Target>
</Project>
